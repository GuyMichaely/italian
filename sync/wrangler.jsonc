{
  // The sync server: one Durable Object keeps the inventory. See README.md.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "italian-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "account_id": "33fbeec446845ec831132810ae18aab5",
  "routes": [{ "pattern": "sync.guymichaely.com", "custom_domain": true }],
  // Access guards the custom domain only, so the workers.dev address stays off.
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "INVENTORY", "class_name": "InventoryStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["InventoryStore"] }],
  "vars": {
    // The app's addresses: where signing in returns to, and the origins allowed to call.
    "APP_URLS": "https://guymichaely.com/italian/ http://localhost:5391/"
  }
}
