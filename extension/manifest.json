{
  "manifest_version": 3,
  "name": "Italian",
  "version": "1.0.7",
  "description": "Add Italian words you meet on the web to your Italian flashcards, filled in from Wiktionary.",
  "update_url": "https://github.com/GuyMichaely/italian/releases/latest/download/updates.xml",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab", "alarms", "offscreen"],
  "host_permissions": ["https://guymichaely.com/italian/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Italian",
    "default_popup": "popup.html"
  }
}
